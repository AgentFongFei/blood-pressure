rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只有名單內的 Google 帳號可以讀寫血壓紀錄。要讓家人也能用，就把他們的 Email 加進清單。
    function allowed() {
      // email_verified 避免有人用「未驗證」的同一個 Email 註冊其他登入方式冒充你。
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['你的Email@gmail.com'];
    }

    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'name', 'systolic', 'diastolic', 'pulse', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.systolic is number
        && d.diastolic is number
        && d.pulse is number;
    }

    match /bp_records/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && validRecord();
    }
  }
}
